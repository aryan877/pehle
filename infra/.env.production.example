# Copy to infra/.env.production on the server. Never commit the filled-in file.
PEHLE_DOMAIN=pehle.example.com
POSTGRES_PASSWORD=change-me-to-a-long-random-string

NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_API_URL=https://api.sg-light-api.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

COHOST_API_URL=https://openrouter.ai/api/v1
COHOST_API_KEY=
COHOST_MODEL=google/gemini-2.5-flash

PEHLE_SECRET_KEY=

# Phone sign-in (Firebase Authentication). Leave both empty to hide phone sign-in.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# Browser notifications: run `pehle-api vapid-keys` once and paste the line here.
PEHLE_VAPID_PRIVATE_KEY=
PEHLE_VAPID_SUBJECT=mailto:hello@example.com

# Read the seller's YouTube live chat for "mine" claims.
YOUTUBE_API_KEY=

# The public demo drop at /try.
PEHLE_DEMO=true
