# Copy to .env for local development.
DATABASE_URL=postgres://pehle:pehle@localhost:54329/pehle
PEHLE_BIND=127.0.0.1:8790
PEHLE_PUBLIC_URL=http://localhost:5173
PEHLE_COOKIE_SECURE=false
PEHLE_DEV_LOGIN=true
PEHLE_MEDIA_DIR=./data/media
RUST_LOG=info,pehle_api=debug,sqlx=warn

# Nexconn console: Chat > App Keys. Webhook URL: <public url>/webhooks/nexconn
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_API_URL=https://api.sg-light-api.com

# Google OAuth web client for seller sign-in. Redirect: <public url>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OpenAI-compatible chat completions endpoint for the AI co-host.
COHOST_API_URL=https://openrouter.ai/api/v1
COHOST_API_KEY=
COHOST_MODEL=google/gemini-2.5-flash

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts sellers' payment gateway secrets.
PEHLE_SECRET_KEY=

# Phone sign-in through Firebase Authentication (see docs/KEYS.md). Leave empty to hide it.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=

# Browser notifications: `./target/debug/pehle-api vapid-keys` prints the key line.
PEHLE_VAPID_PRIVATE_KEY=
PEHLE_VAPID_SUBJECT=mailto:dev@localhost

# YouTube Data API v3 key: read the seller's YouTube live chat for "mine" claims.
YOUTUBE_API_KEY=

# The public demo drop at /try.
PEHLE_DEMO=true
